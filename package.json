{
  "name": "marks-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "validate:questions": "node scripts/validate-questions.mjs",
    "validate:syllabus": "node scripts/validate-syllabus.mjs",
    "validate": "npm run validate:questions && npm run validate:syllabus",
